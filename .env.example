# Copiar a .env y completar. NUNCA commitear .env.
# Valores con '$' (p. ej. el hash BCrypt) van entre comillas simples.

POSTGRES_DB=clientes
POSTGRES_USER=clientes_app
# Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=

MONGO_USER=mongo_root
# Generar con: openssl rand -hex 24  (hex: evita caracteres que romperían la URI)
MONGO_PASSWORD=

# Usuario de la APLICACIÓN en MongoDB (readWrite solo sobre la base "auditoria"); el backend usa este, no el root.
MONGO_APP_USER=auditoria_app
# Generar con: openssl rand -hex 24
MONGO_APP_PASSWORD=

# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=15

ADMIN_USER=admin
# Hash BCrypt de la contraseña del administrador, p. ej.:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 10 "" 'su-contraseña' | cut -d: -f2 | sed 's/^\$2y/\$2a/'
ADMIN_PASSWORD_HASH=

LOG_LEVEL=INFO
